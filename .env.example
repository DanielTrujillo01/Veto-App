# Copia este archivo a ".env" (cp .env.example .env) y completa los valores.

# Base de datos: la cadena de conexión de tu proyecto de Supabase (Project Settings → Database →
# Connection string). Reemplaza [YOUR-PASSWORD] por la contraseña; si la conexión directa falla por
# IPv6, usa la del pooler. Nunca subas el .env con la contraseña real.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Alternativa local con Docker (pnpm db:up). El puerto 5440 evita choques con un PostgreSQL ya
# instalado en tu equipo.
# DATABASE_URL=postgres://veto:veto@localhost:5440/veto

# API (NestJS)
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Correo de recuperación (desarrollo: Mailpit desde docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Para SMTP autenticado, define ambos valores en .env; no los subas a Git.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Veto <no-reply@veto.local>

# Alternativa sin costo para pruebas iniciales con una cuenta personal de Gmail:
# 1. Activa la verificación en dos pasos de la cuenta Google.
# 2. Crea una contraseña de aplicación y usa sus 16 caracteres (no la contraseña normal).
# 3. Copia estos valores a .env y sustituye los marcadores. MAIL_FROM debe usar esa cuenta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicación
# MAIL_FROM=Veto <tu-cuenta@gmail.com>
