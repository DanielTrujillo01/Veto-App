# Copia este archivo a ".env" (cp .env.example .env) y completa los valores.

# Base de datos: la cadena de conexión de tu proyecto de Supabase (Project Settings → Database →
# Connection string). Reemplaza [YOUR-PASSWORD] por la contraseña; si la conexión directa falla por
# IPv6, usa la del pooler. Nunca subas el .env con la contraseña real.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Alternativa local con Docker (pnpm db:up). El puerto 5440 evita choques con un PostgreSQL ya
# instalado en tu equipo.
# DATABASE_URL=postgres://veto:veto@localhost:5440/veto

# API (NestJS)
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Inicio de sesión con Google (HU-003, opcional). Crea unas credenciales "ID de cliente de OAuth"
# de tipo aplicación web en https://console.cloud.google.com/apis/credentials y registra como
# URI de redirección autorizado la de GOOGLE_REDIRECT_URI. Sin client id y secret, el botón de
# Google queda desactivado. Nunca subas el secreto.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/identidad/google/callback
